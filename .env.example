# Server-only Supabase project credentials. Never use NEXT_PUBLIC_ for service-role keys.
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVER_ONLY_SERVICE_ROLE_KEY
# Public anon/publishable key, passed only to the editor sign-in UI.
SUPABASE_ANON_KEY=YOUR_PUBLIC_ANON_OR_PUBLISHABLE_KEY
# Supabase PostgreSQL connection. Copy the transaction pooler URL from Connect.
# URL-encode special characters in the password. Runtime uses prepare:false.
DATABASE_URL=postgresql://postgres.YOUR_PROJECT:YOUR_ENCODED_PASSWORD@YOUR_POOLER_HOST:6543/postgres?sslmode=require
# Comma-separated emails of explicitly authorised Supabase Auth users.
BLOG_EDITOR_EMAILS=YOUR_EDITOR_EMAIL
